# ---------------------------------------------------------------------------
# federated_breast_flare — generated, never committed
# ---------------------------------------------------------------------------
# PKI startup kits. These hold PRIVATE KEYS: committing them would publish the
# identity of every hospital and of the admin. Regenerate with scripts/provision.sh.
/federated_breast_flare/federation/provisioning/production/

# Per-hospital datasets: real copies of the PNGs, rebuilt by scripts/partition_data.py
# in under a minute. Several GB, and derived from BreastDCEDL/ which is also ignored.
/federated_breast_flare/data/global/
/federated_breast_flare/data/partitions/

# Run outputs: checkpoints and logs. The tabulated results (all_experiments.csv) are
# small and ARE worth keeping, so they are un-ignored below.
/federated_breast_flare/results/*
!/federated_breast_flare/results/README.md
!/federated_breast_flare/results/all_experiments.csv

# =============================================================================
# PROJECT-SPECIFIC
# =============================================================================

# Local-only archive of superseded code, datasets and runs. Never committed;
# it is not part of the deliverable and the documentation does not refer to it.
unused/

# Raw imaging release from Zenodo (35 GB). Obtain it by running
# raw_dataset_BreastDCEDL/download_dataset.py rather than from version control.
#
# The folder is ignored by CONTENT, not as a whole: git will not descend into an
# ignored directory, so its own documentation and downloader have to be named
# back in or they disappear with the imaging.
raw_dataset_BreastDCEDL/*
!raw_dataset_BreastDCEDL/README.md
!raw_dataset_BreastDCEDL/download_dataset.py
data_set_BreastDCEDL/
BreastDCEDL/

# Processed dataset: the manifests and the build configuration ARE tracked,
# because they define the dataset; the 16,378 PNG slices are not.
dataset/images/
dataset/*/images/
breastdcedl_thesis/data/*/images/

# PKI startup kits hold PRIVATE KEYS for every participant. Never commit these.
deployment/workspace/
**/workspace/breast_fl_project/
**/prod_[0-9][0-9]/

# Trained weights and archives. Metrics, predictions and per-round CSVs are
# tracked; the model files they describe are not.
*.pt
*.pth
*.tar.gz
*.zip

# macOS
.DS_Store

# Federated data layout: the split manifests (train.csv / val.csv / test.csv and
# the per-site manifest.json) ARE tracked, because they define the partitions.
# The PNGs are hardlinks into the processed dataset and are regenerated
# deterministically at seed 42 by prepare_data.py and partition_data.py.
federated/data/**/images/
data/global/images/
data/partitions/**/images/
**/hospital_[0-9]/images/

# Superseded experiment output, kept on disk but never committed.
# See old_runs/README.md for what each folder was.
old_runs/

# Rented-pod runs from the 2026-08-06/07 re-run campaign. None is reported in the
# dissertation; the thirteen reported results live in results/federated/.
# See unused_old_run_pod_07-08/README.md for what each folder holds.
unused_old_run_pod_07-08/
docs/PROJECT_CONTEXT.md
docs/PROJECT_HISTORY.md
