{
  "train": {
    "model_name": "resnet18",
    "pretrained": true,
    "image_size": 224,
    "num_classes": 3,
    "batch_size": 24,
    "learning_rate": 0.0001,
    "weight_decay": 0.0005,
    "dropout": 0.5,
    "epochs": 100,
    "early_stopping_patience": 30,
    "scheduler": "cosine",
    "optimizer": "adamw",
    "label_smoothing": 0.1,
    "class_weighted_loss": true,
    "slice_selection": "all",
    "n_central": 5,
    "train_mode": "full",
    "freeze_until": "none",
    "freeze_bn": false,
    "mixup_alpha": 0.0,
    "aug_profile": "default",
    "backbone_lr_scale": 0.1,
    "max_slices_per_patient_per_batch": 1,
    "mixed_precision": true,
    "num_workers": 16,
    "seed": 42,
    "aggregation": "mean",
    "monitor_metric": "patient_auc",
    "monitor_mode": "max"
  },
  "augment": {
    "enabled": true,
    "horizontal_flip": 0.5,
    "vertical_flip": 0.0,
    "rotation_degrees": 15.0,
    "scale_range": [
      0.9,
      1.1
    ],
    "translate_fraction": 0.08,
    "brightness_range": [
      0.8,
      1.2
    ],
    "gaussian_noise_std": [
      0.005,
      0.03
    ],
    "cutout_probability": 0.0,
    "rotation_probability": 1.0,
    "scale_probability": 1.0,
    "translate_probability": 1.0,
    "brightness_probability": 1.0,
    "noise_probability": 0.25
  }
}